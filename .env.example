# ---------------------------------------------------------------------------
# TradeX environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` — it is gitignored on purpose.
# ---------------------------------------------------------------------------

# Supabase — find these in your Supabase dashboard:
#   Project Settings (gear icon) -> Data API / API
#   - "Project URL"      -> NEXT_PUBLIC_SUPABASE_URL
#   - "anon public" key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The service_role key is SECRET. Only used in server-side admin actions.
# Find it in the same API settings page under "service_role". Do NOT expose it
# to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public site URL, used for auth redirects. Locally this is the dev server.
# In production set it to your Vercel domain, e.g. https://tradex.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
