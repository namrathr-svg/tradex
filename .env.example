# ---------------------------------------------------------------------------
# TradeX environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` — it is gitignored on purpose.
# ---------------------------------------------------------------------------

# Supabase — find these in your Supabase dashboard:
#   Project Settings (gear icon) -> API Keys
#   - "Project URL" (Data API page) -> NEXT_PUBLIC_SUPABASE_URL
#   - "Publishable key" (sb_publishable_...) -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     (On older projects this is called the "anon public" key — same thing.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# The Secret key is SECRET. Only used in server-side admin actions.
#   "Secret key" (sb_secret_...) -> SUPABASE_SERVICE_ROLE_KEY
#     (On older projects this is called the "service_role" key — same thing.)
# Do NOT expose it to the browser (no NEXT_PUBLIC_ prefix), never commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# The public site URL, used for auth redirects. Locally this is the dev server.
# In production set it to your Vercel domain, e.g. https://tradex.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
